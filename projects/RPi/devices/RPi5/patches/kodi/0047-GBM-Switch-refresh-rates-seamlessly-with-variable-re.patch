@@ -25,6 +25,9 @@
 #define D3DPRESENTFLAG_PROGRESSIVE  4
 #define D3DPRESENTFLAG_MODE3DSBS    8
 #define D3DPRESENTFLAG_MODE3DTB    16
+// The display switches between the modes with this flag without resynchronising
+// (variable refresh rate). Not a mode-setting flag.
+#define D3DPRESENTFLAG_VRR         32
 
 /* what types are important for mode setting */
 #define D3DPRESENTFLAG_MODEMASK ( D3DPRESENTFLAG_INTERLACED \
diff --git a/xbmc/windowing/Resolution.cpp b/xbmc/windowing/Resolution.cpp
index 2020a93f9..64adfdc72 100644
--- a/xbmc/windowing/Resolution.cpp
+++ b/xbmc/windowing/Resolution.cpp
@@ -84,6 +84,67 @@ const RESOLUTION_INFO& NativeModeInfo(const CVariant& mode)
   return displaySettings.GetResolutionInfo(displaySettings.GetResFromString(mode.asString()));
 }
 
+//! @brief Pick a variable refresh rate mode for the frame rate, or twice it, of a size
+//!        the whitelist allows that fits the video. The display switches between those
+//!        modes without resynchronising. They are matched as resolutions: their whitelist
+//!        string can be the same as that of an ordinary mode of the same rate.
+bool FindVrrResolution(const std::vector<CVariant>& indexList,
+                       int width,
+                       int height,
+                       float fps,
+                       const RESOLUTION_INFO& curr,
+                       uint32_t modeMask,
+                       RESOLUTION& resolution)
+{
+  std::vector<RESOLUTION> candidates;
+  CServiceBroker::GetWinSystem()->GetGfxContext().GetAllowedResolutions(candidates);
+
+  for (const float rate : {fps, fps * 2})
+  {
+    RESOLUTION best = RES_INVALID;
+    unsigned int penalty = std::numeric_limits<unsigned int>::max();
+
+    for (const RESOLUTION c : candidates)
+    {
+      const RESOLUTION_INFO& native = CDisplaySettings::GetInstance().GetResolutionInfo(c);
+      if (!(native.dwFlags & D3DPRESENTFLAG_VRR) ||
+          !MathUtils::FloatEquals(native.fRefreshRate, rate, 0.01f) ||
+          native.iScreenWidth + 8 < width || native.iScreenHeight + 32 < height)
+        continue;
+
+      if (std::ranges::none_of(indexList,
+                               [&native](const CVariant& mode)
+                               {
+                                 const RESOLUTION_INFO& allowed = NativeModeInfo(mode);
+                                 return allowed.iScreenWidth == native.iScreenWidth &&
+                                        allowed.iScreenHeight == native.iScreenHeight;
+                               }))
+        continue;
+
+      const RESOLUTION_INFO info = CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(c);
+      if ((info.dwFlags & modeMask) != (curr.dwFlags & modeMask))
+        continue;
+
+      const unsigned int pen = abs(info.iScreenHeight - height) + abs(info.iScreenWidth - width);
+      if (pen < penalty)
+      {
+        best = c;
+        penalty = pen;
+      }
+    }
+
+    if (best != RES_INVALID)
+    {
+      resolution = best;
+      CLog::Log(LOGDEBUG, "[WHITELIST] Matched a variable refresh rate mode {} ({})",
+                CDisplaySettings::GetInstance().GetResolutionInfo(best).strMode, best);
+      return true;
+    }
+  }
+
+  return false;
+}
+
 //! @brief The 2D timing a mode carries. A half 3D mode transmits one eye inside an
 //!        ordinary frame, so its geometry is already the 2D one. Frame packing sends
 //!        both eyes plus an active space gap, so divide those out - only a
@@ -621,6 +682,9 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps,
     CLog::Log(LOGDEBUG, "[WHITELIST] No native 3D mode matched, continuing the standard search");
   }
 
+  if (wants2D && FindVrrResolution(indexList, width, height, fps, curr, modeMask, resolution))
+    return;
+
   CLog::Log(LOGDEBUG, "[WHITELIST] Searching for an exact resolution with an exact refresh rate");
 
   unsigned int penalty = std::numeric_limits<unsigned int>::max();

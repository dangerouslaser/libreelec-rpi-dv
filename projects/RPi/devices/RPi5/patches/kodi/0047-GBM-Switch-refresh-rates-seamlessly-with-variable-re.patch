@@ -871,6 +876,42 @@ CDRMUtils::CommitState CDRMUtils::GetCommitState(uint64_t sequence)
   return ret > 0 ? CommitState::COMPLETE : CommitState::PENDING;
 }
 
+namespace
+{
+bool IsProgressive2D(const drmModeModeInfo& mode)
+{
+  return !(mode.flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_DBLCLK |
+                         DRM_MODE_FLAG_3D_MASK));
+}
+
+//! Whether the modes only differ in their vertical front porch.
+bool SameTimingButFrontPorch(const drmModeModeInfo& a, const drmModeModeInfo& b)
+{
+  return a.clock == b.clock && a.hdisplay == b.hdisplay && a.hsync_start == b.hsync_start &&
+         a.hsync_end == b.hsync_end && a.htotal == b.htotal && a.hskew == b.hskew &&
+         a.vdisplay == b.vdisplay && a.vsync_end - a.vsync_start == b.vsync_end - b.vsync_start &&
+         a.vtotal - a.vsync_end == b.vtotal - b.vsync_end && a.vscan == b.vscan &&
+         a.flags == b.flags;
+}
+} // namespace
+
+//! With variable refresh rate, the driver switches between the modes of a size that only
+//! differ in their vertical front porch without a modeset.
+bool CDRMUtils::IsVrrMode(const drmModeModeInfo& mode) const
+{
+  if (!m_vrr || !IsProgressive2D(mode))
+    return false;
+
+  for (int i = 0; i < m_connector->GetModesCount(); i++)
+  {
+    const drmModeModeInfo* other = m_connector->GetModeForIndex(i);
+    if (other->vtotal != mode.vtotal && SameTimingButFrontPorch(*other, mode))
+      return true;
+  }
+
+  return false;
+}
+
 RESOLUTION_INFO CDRMUtils::GetResolutionInfo(drmModeModeInfoPtr mode)
 {
   RESOLUTION_INFO res;
@@ -938,6 +979,8 @@ RESOLUTION_INFO CDRMUtils::GetResolutionInfo(drmModeModeInfoPtr mode)
 
   res.dwFlags = mode->flags & DRM_MODE_FLAG_INTERLACE ? D3DPRESENTFLAG_INTERLACED
                                                       : D3DPRESENTFLAG_PROGRESSIVE;
+  if (IsVrrMode(*mode))
+    res.dwFlags |= D3DPRESENTFLAG_VRR;
 
   // The 3D layout is a masked enum, not independent bits (TOP_AND_BOTTOM is
   // 7<<14 and shares bit 14 with FRAME_PACKING 1<<14), so match the whole field.

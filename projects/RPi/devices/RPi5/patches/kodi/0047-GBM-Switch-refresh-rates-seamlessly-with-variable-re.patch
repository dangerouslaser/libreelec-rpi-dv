   std::vector<std::string> GetConnectedConnectorNames();
 
@@ -141,6 +142,8 @@ protected:
   CDRMPlane* m_video_plane2{nullptr};
   CDRMPlane* m_gui_plane{nullptr};
   drmModeModeInfo* m_mode = nullptr;
+  //! The driver drives the connector with variable refresh rate once VRR_ENABLED is set.
+  bool m_vrr{false};
 
   int m_width = 0;
   int m_height = 0;
@@ -161,6 +164,7 @@ private:
   bool FindPreferredMode();

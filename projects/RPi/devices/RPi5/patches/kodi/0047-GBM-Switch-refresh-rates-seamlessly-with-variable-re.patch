 xbmc/windowing/Resolution.cpp        | 64 ++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp |  3 ++
 xbmc/windowing/gbm/drm/DRMUtils.cpp  | 43 +++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h    |  4 ++
 5 files changed, 117 insertions(+)


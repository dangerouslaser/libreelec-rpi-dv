+
+void CWinSystemGbm::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting || setting->GetId() != SETTING_WINSYSTEM_VRR || !m_DRM)
+    return;
+
+  // The modes the display switches between without resynchronising are flagged
+  // only while VRR is on, and VRR_ENABLED goes with the next modeset.
+  UpdateResolutions();
+  m_DRM->ForceModeset();
+}
+
 bool CWinSystemGbm::IsHDRDisplay()
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);

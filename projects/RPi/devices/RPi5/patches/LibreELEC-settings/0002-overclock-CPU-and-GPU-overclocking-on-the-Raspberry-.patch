@@ -0,0 +1,562 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026-present Team LibreELEC (https://libreelec.tv)
+
+"""Overclocking (Raspberry Pi 5). Every operation is pi-overclock --json;
+this module only shows its results and asks it to do things."""
+
+import json
+import os
+import signal
+import subprocess
+import threading
+import time
+
+import xbmc
+import xbmcgui
+
+import log
+import modules
+import oe
+
+
+CLI = '/usr/bin/pi-overclock'
+STATE_FILE = '/storage/.config/overclock/state.json'
+
+PRESET_NAMES = {
+    'stock': 32711,
+    'mild': 32712,
+    'moderate': 32713,
+    'high': 32714,
+    'custom': 32715,
+}
+THROTTLE_NAMES = {
+    'under_voltage': 32750,
+    'arm_capped': 32751,
+    'throttled': 32752,
+    'soft_temp_limit': 32753,
+}
+REASONS = {
+    'throttled': 32760,
+    'temp_high': 32761,
+    'clock_low': 32762,
+    'verify_failed': 32763,
+    'load_failed': 32764,
+    'kernel_errors': 32765,
+    'gpu_mismatch': 32766,
+    'gpu_failed': 32767,
+    'not_applied': 32768,
+    'trial_incomplete': 32769,
+}
+
+
+def cli(*args, timeout=60):
+    try:
+        out = subprocess.run([CLI, *args, '--json'], capture_output=True, text=True, timeout=timeout)
+        return json.loads(out.stdout.strip().splitlines()[-1])
+    except Exception as e:
+        log.log(f'pi-overclock {" ".join(args)}: {repr(e)}', log.ERROR)
+        return {'ok': False, 'error': {'code': 'cli', 'message': repr(e)}}
+
+
+def mhz(value):
+    return oe._(32740) % value if value else '-'
+
+
+def describe(settings):
+    if not settings:
+        return oe._(32711)
+    parts = []
+    if 'arm_freq' in settings:
+        parts.append(oe._(32741) % settings['arm_freq'])
+    if settings.get('over_voltage_delta'):
+        parts.append(oe._(32742) % (settings['over_voltage_delta'] / 1000))
+    if 'v3d_freq' in settings:
+        parts.append(oe._(32743) % settings['v3d_freq'])
+    return ', '.join(parts)
+
+
+def preset_label(preset, settings=None):
+    name = oe._(PRESET_NAMES.get(preset, 32715))
+    if settings:
+        return f'{name} ({describe(settings)})'
+    return name
+
+
+def throttle_text(flags):
+    return ', '.join(oe._(THROTTLE_NAMES[f]) for f in flags if f in THROTTLE_NAMES)
+
+
+def reason_text(reason):
+    if not reason:
+        return ''
+    code = reason.get('code')
+    if code == 'throttled':
+        return oe._(32760) % throttle_text(reason.get('flags', []))
+    if code == 'temp_high':
+        return oe._(32761) % reason.get('temp', 0)
+    if code == 'clock_low':
+        return oe._(32762) % (reason.get('mhz', 0), reason.get('target', 0))
+    if code in REASONS:
+        return oe._(REASONS[code])
+    return reason.get('message', code or '')
+
+
+class overclock(modules.Module):
+
+    ENABLED = False
+    menu = {'8': {
+        'name': 32700,
+        'menuLoader': 'load_menu',
+        'listTyp': 'list',
+        'InfoText': 32701,
+    }}
+
+    @log.log_function()
+    def __init__(self, oeMain):
+        super().__init__()
+        self.ENABLED = oe.DEVICE == 'RPi5' and os.path.exists(CLI)
+        self.limits = None
+        self.status = None
+        self.expert = False
+        self.selected = None
+        self.custom = {}
+        self.poller = None
+        self.events_thread = None
+
+    # ---------------------------------------------------------------- data
+
+    def load_limits(self):
+        if not self.limits:
+            data = cli('limits')
+            if 'limits' in data:
+                self.limits = data
+        return self.limits
+
+    def preset_settings(self, preset):
+        for p in self.limits['presets']:
+            if p['id'] == preset:
+                return dict(p['settings'])
+        return None
+
+    def selected_settings(self):
+        if self.selected == 'custom':
+            return {k: v for k, v in self.custom.items() if v is not None and not (k == 'over_voltage_delta' and v == 0)}
+        return self.preset_settings(self.selected) or {}
+
+    def range_values(self, key):
+        lim = self.limits['limits'][key]
+        return [str(v) for v in range(lim['min'], lim['max'] + 1, lim['step'])]
+
+    # ---------------------------------------------------------------- menu
+
+    @log.log_function()
+    def load_menu(self, focusItem):
+        if not self.load_limits():
+            oe.winOeMain.build_menu({'error': {'order': 1, 'name': 32700, 'settings': {
+                'error': {'name': 32790, 'value': '', 'action': '', 'type': 'readonly', 'order': 1}}}})
+            return
+        self.status = cli('status')
+        self.expert = oe.read_setting('overclock', 'expert') == '1'
+        committed = self.status.get('committed', {})
+        if self.selected is None:
+            self.selected = committed.get('preset', 'stock')
+            self.custom = dict(committed.get('settings', {}))
+        if self.selected == 'custom' and not self.expert:
+            self.selected = committed.get('preset', 'stock')
+            if self.selected == 'custom':
+                self.selected = 'stock'
+        oe.winOeMain.build_menu(self.build_struct())
+        self.start_polling()
+
+    def build_struct(self):
+        st = self.status
+        committed = st.get('committed', {})
+        selected = self.selected_settings()
+        uv_block = st.get('undervoltage_since_boot') and self.above_mild(selected)
+        trial_running = st.get('tryboot') and st.get('pending_trial')
+        last_trial = st.get('last_trial')
+
+        presets = [p['id'] for p in self.limits['presets']] + (['custom'] if self.expert else [])
+        preset_values = [oe._(PRESET_NAMES[p]) for p in presets]
+        v3d_values = [oe._(32711)] + self.range_values('v3d_freq')
+        custom_hidden = not (self.expert and self.selected == 'custom')
+
+        def readonly(name, value, order, info=32702):
+            return {'name': name, 'value': value, 'action': '', 'type': 'readonly', 'InfoText': info, 'order': order}
+
+        def button(name, action, order, info, hidden=False):
+            entry = {'name': name, 'value': '', 'action': action, 'type': 'button', 'InfoText': info, 'order': order}
+            if hidden:
+                entry['hidden'] = 'true'
+            return entry
+
+        status = {
+            'arm': readonly(32703, '', 1),
+            'v3d': readonly(32704, '', 2),
+            'temp': readonly(32705, '', 3),
+            'fan': readonly(32706, '', 4),
+            'throttle': readonly(32707, '', 5),
+            'committed': readonly(32708, preset_label(committed.get('preset', 'stock'), committed.get('settings')), 6, 32709),
+            'lasttest': readonly(32710, self.test_text(st.get('last_test')), 7),
+        }
+        if last_trial:
+            status['lasttrial'] = readonly(32716, self.trial_text(last_trial), 8)
+        if trial_running:
+            status['trial'] = readonly(32717, oe._(32718), 9)
+        self.fill_live(status, st)
+
+        changed = selected != committed.get('settings', {})
+        profile = {
+            'expert': {'name': 32720, 'value': '1' if self.expert else '0', 'action': 'set_expert',
+                       'type': 'bool', 'InfoText': 32721, 'order': 1},
+            'preset': {'name': 32722, 'value': oe._(PRESET_NAMES[self.selected]), 'action': 'set_preset',
+                       'type': 'multivalue', 'values': preset_values, 'InfoText': 32723, 'order': 2},
+            'pending': readonly(32724, describe(selected) if changed else oe._(32725), 3, 32726),
+        }
+        custom = {
+            'arm_freq': {'name': 32727, 'value': str(self.custom.get('arm_freq', self.limits['stock']['arm_freq'])),
+                         'action': 'set_custom', 'type': 'multivalue', 'values': self.range_values('arm_freq'),
+                         'InfoText': 32728, 'order': 1},
+            'over_voltage_delta': {'name': 32729, 'value': str(self.custom.get('over_voltage_delta', 0)),
+                                   'action': 'set_custom', 'type': 'multivalue',
+                                   'values': self.range_values('over_voltage_delta'), 'InfoText': 32730, 'order': 2},
+            'v3d_freq': {'name': 32731, 'value': str(self.custom['v3d_freq']) if 'v3d_freq' in self.custom else oe._(32711),
+                         'action': 'set_custom', 'type': 'multivalue', 'values': v3d_values,
+                         'InfoText': 32732, 'order': 3},
+        }
+        apply_name = oe._(32733) + (f' ({oe._(32734)})' if uv_block else '')
+        actions = {
+            'apply': button(apply_name, 'do_apply', 1, 32735),
+            'apply_notest': button(32736, 'do_apply_notest', 2, 32737, hidden=not self.expert),
+            'retry': button(32738, 'do_retry', 3, 32739,
+                            hidden=not (last_trial and not last_trial.get('passed') and last_trial.get('can_retry'))),
+            'extended': button(32744, 'do_extended_test', 4, 32745),
+            'revert': button(32746, 'do_revert', 5, 32747),
+        }
+        helps = {
+            'cooling': button(32780, 'show_help', 1, 32781),
+            'benefits': button(32782, 'show_help', 2, 32783),
+            'recovery': button(32784, 'show_help', 3, 32785),
+        }
+        struct = {
+            'status': {'order': 1, 'name': 32719, 'settings': status},
+            'profile': {'order': 2, 'name': 32748, 'settings': profile},
+            'custom': {'order': 3, 'name': 32749, 'settings': custom},
+            'actions': {'order': 4, 'name': 32754, 'settings': actions},
+            'help': {'order': 5, 'name': 32755, 'settings': helps},
+        }
+        if custom_hidden:
+            struct['custom']['hidden'] = 'true'
+        return struct
+
+    def above_mild(self, settings):
+        mild = self.preset_settings('mild')
+        return (settings.get('arm_freq', self.limits['stock']['arm_freq']) > mild['arm_freq']
+                or settings.get('over_voltage_delta', 0) > 0 or 'v3d_freq' in settings)
+
+    def test_text(self, result):
+        if not result:
+            return oe._(32756)
+        when = time.strftime('%Y-%m-%d %H:%M', time.localtime(result['time']))
+        if result.get('cancelled'):
+            verdict = oe._(32757)
+        elif result.get('passed'):
+            verdict = oe._(32758)
+        else:
+            verdict = oe._(32759)
+        text = f"{verdict} {when}"
+        if result.get('max_temp') is not None:
+            text += ', ' + oe._(32770) % result['max_temp']
